{
  "name": "NOWnews-admin-website",
  "version": "0.0.1",
  "description": "NOWnews Admin service",
  "main": "index.js",
  "scripts": {
    "start": "npm install && NODE_ENV=develop DEBUG=NOWnews-admin-website* ./node_modules/nodemon/bin/nodemon.js ./bin/admin.js",
    "staging": "npm install && NODE_ENV=staging DEBUG=NOWnews-admin-website* ./node_modules/nodemon/bin/nodemon.js ./bin/admin.js",
    "build:staging": "NODE_ENV=staging node_modules/webpack/bin/webpack.js --progress --hide-modules",
    "build": "NODE_ENV=production node_modules/webpack/bin/webpack.js --progress --hide-modules",
    "prod": "NODE_ENV=production node ./bin/server"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com:nownews/NOWnews-admin-website.git"
  },
