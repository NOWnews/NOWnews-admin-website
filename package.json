{
    "name": "NOWnewsAdmin",
    "version": "0.0.1",
    "description": "NOWnews Admin service",
    "main": "index.js",
    "scripts": {
        "start": "npm install && NODE_ENV=staging DEBUG=NOWnewsAdmin* ./node_modules/nodemon/bin/nodemon.js ./bin/admin.js",
