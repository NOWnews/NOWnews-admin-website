  "bugs": {
    "url": "https://gitlab.com/nownews/NOWnews-admin-website/issues"
  },
  "homepage": "https://gitlab.com/nownews/NOWnews-admin-website#README",
  "dependencies": {
    "axios": "^0.15.3",
    "babel-core": "^6.23.1",
    "babel-polyfill": "^6.23.0",
    "babel-preset-es2015": "^6.22.0",
    "babel-preset-stage-0": "^6.22.0",
    "bluebird": "3.4.6",
    "body-parser": "1.15.2",
    "bower": "1.7.9",
    "chalk": "1.1.3",
    "co": "4.6.0",
    "compression": "1.6.2",
    "concat-stream": "^1.6.0",
    "config": "^1.25.1",
    "cookie-parser": "1.4.3",
    "cookie-session": "2.0.0-alpha.1",
    "cors": "2.8.0",
    "debug": "2.2.0",
    "express": "4.14.0",
    "form-data": "^2.1.2",
    "html-minifier": "^3.4.2",
    "is_js": "0.8.0",
    "lodash": "4.15.0",
    "md5": "2.2.1",
    "method-override": "^2.3.6",
